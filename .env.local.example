NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — needed for AI Security Assistant (/tools/ai-assistant) and the
# Roleplay Penipu simulator (/tools/roleplay). Get a free key at
# https://aistudio.google.com/apikey. Without this set, the rest of the site
# works normally; those two tools just show a friendly "belum dikonfigurasi"
# message instead of crashing.
GEMINI_API_KEY=your-gemini-api-key

# Optional — adds a real threat-intel verification layer to the URL Scanner
# (/tools/url-scanner). Enable "Safe Browsing API" for your GCP project at
# https://console.cloud.google.com/. Without this set, the scanner still
# works fully via its own heuristic engine.
GOOGLE_SAFE_BROWSING_API_KEY=your-safe-browsing-api-key
